---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { formatDate, getPosts, logId, withBase, type Post } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    // The list is newest first, so the following item is the older entry.
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary} image={post.data.cover} type="article">
  <article class="wrap article">
    <header>
      <p class="meta label">
        <span>{logId(post)}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{post.data.category}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <StatusBadge status={post.data.status} />
    </header>

    {post.data.cover && <img class="cover" src={withBase(post.data.cover)} alt={post.data.coverAlt} />}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More entries">
      {older ? <a rel="prev" href={withBase(`/devlog/${older.id}/`)}><span class="label">Older</span>{older.data.title}</a> : <span />}
      <a class="all" href={withBase('/devlog/')}>All entries</a>
      {newer ? <a rel="next" class="newer" href={withBase(`/devlog/${newer.id}/`)}><span class="label">Newer</span>{newer.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .article { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  header { max-width: var(--measure); margin-bottom: 2.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; margin: 0 0 0.9rem; }
  h1 { margin: 0 0 1rem; font-size: clamp(2rem, 1.5rem + 2.4vw, 3.2rem); }
  .summary { margin: 0 0 1rem; font-size: 1.18em; color: var(--muted); }
  .cover { width: 100%; max-width: var(--wide); margin-bottom: 2.5rem; border: 1px solid var(--panel-edge); }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem 2rem;
    align-items: start;
    max-width: var(--measure);
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--panel-edge);
    font-family: var(--display);
    font-size: 0.98rem;
  }
  .pager .label { display: block; margin-bottom: 0.2rem; }
  .newer { text-align: right; }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .newer { text-align: left; }
  }
</style>
