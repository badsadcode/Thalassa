# Unreal generated output
Binaries/
Intermediate/
Saved/
DerivedDataCache/
# Root only: on Windows a bare "Build/" also matches Scripts/build.
/Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# IDE / machine-specific
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.user
*.VC.db
*.VC.opendb

# Secrets: never commit
.env
.env.*
*.pem
*.key

# Local Claude Code state
.claude/settings.local.json

# Devlog site
site/node_modules/
site/dist/
site/.astro/

# Local preview config
.claude/

# Blender backups and Python caches
*.blend1
__pycache__/

# Game assets stay on the owner's machine, not on GitHub (owner's decision, 2026-11-09: no storage costs).
# Content/ also holds Fab Marketplace assets, whose licence forbids sharing their source files publicly.
# Back these folders up yourself. Their history up to then is still in the repo (Git LFS).
/Content/
/Art/
